[all:vars]
ansible_private_key_file=~/.ssh/robotont
robotont_user=peko
robotont_group=peko
robotont_password=
ros_domain_id=0 # default ROS domain ID for all hosts, can be overridden per host, if not set, ROS domain ID will be determined by host ID
wifi_hotspot_password=
wifi_client_ssid=
wifi_client_password=

[local]
localhost id=1 is_robot=1

[robots:vars]
is_robot=1

[robots]
192.168.200.1 id=1 ansible_user=peko
#192.168.200.2 id=2 ansible_user=peko
#192.168.200.3 id=3 ansible_user=peko

[laptops]
#192.168.1.100 id=1 ansible_user=peko
#192.168.1.101 id=2 ansible_user=peko
#192.168.1.102 id=3 ansible_user=peko
